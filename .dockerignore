# =============================================================================
# .dockerignore — dashboard-app (Spring Boot / Maven / Java 17)
#
# Excludes build artefacts, wrapper scripts, IDE metadata, and source files
# that must NOT be present in the Docker build context.
# =============================================================================

# Maven build output — rebuilt inside the container
target/

# Maven wrapper scripts — NEVER used inside Docker (system mvn is used instead)
mvnw
mvnw.cmd
.mvn/

# Gradle wrapper scripts (not used in this project, excluded for safety)
gradlew
gradlew.bat
gradle/wrapper/
gradle/

# Git metadata
.git/
.gitignore
.gitattributes

# IDE / editor metadata
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/

# OS artefacts
.DS_Store
Thumbs.db

# Documentation
*.md
docs/

# CI/CD configuration (not needed at runtime)
buildspec.yml
Jenkinsfile
.travis.yml
.github/

# Test reports and coverage
**/surefire-reports/
**/failsafe-reports/
**/jacoco/

# CSS preprocessor source files (not needed for Java runtime)
**/*.scss
**/*.sass
**/*.less
**/*.styl
**/*.stylus
**/*.css.map
**/*.scss.map
**/*.less.map

# Node.js artefacts (CSS build tooling — not needed for Java runtime)
node_modules/
package.json
package-lock.json
purgecss.config.js

# Development / debug CSS files
assets/styles/styles.dev.css
assets/styles/purged/
assets/styles/*.dev.css
assets/styles/debug.css
assets/styles/test*.css
**/*.dev.css

# Existing Docker / ECS artefacts (regenerated by this pipeline)
docker-compose.yml
ecs/
scripts/
